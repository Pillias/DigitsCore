    <string name="privacy_local_title">Usage data stays on your device</string>
    <string name="privacy_local_body">App names, usage time, app-open counts, and observed unlock events are used to calculate your score. Nothing is sent to the developer or a server, and you can turn off access and tracking at any time.</string>
